index 0000000..bd37300
--- /dev/null
+++ b/gr00t/experiment/muon.py
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+# Single-GPU, CPU-offload-aware Muon/AdamW hybrid optimizer for GR00T N1.7 (paper C3).
+#
+# Design:
+#  * Muon: 2D weights of attn1/ff inside VL-SA and DiT transformer blocks
+#    (whitelist predicate; excludes norms/biases/embeddings/CategorySpecific 3D banks).
+#  * AdamW: everything else trainable.
+#  * Offload-aware: momentum buffers live on CPU (pinned); each step the 2D buffer
+#    is moved to GPU, orthogonalized by Newton-Schulz (5 iters, bf16), moved back.
+#    Parameters themselves follow FSDP2 CPUOffloadPolicy residency.
+import logging
+from typing import Iterable
+
+import torch
+from torch.optim import Optimizer
+
+logger = logging.getLogger(__name__)
+
+
+def ns_newtonschulz5(G: torch.Tensor, steps: int = 5) -> torch.Tensor:
+    """Approximate the polar factor UV^T of G (Keller Jordan's quintic coefficients)."""
+    assert G.ndim == 2
+    a, b, c = (3.4445, -4.7750, 2.0315)
+    X = G.bfloat16()
+    transposed = False
+    if G.size(0) > G.size(1):
+        X = X.T
+        transposed = True
+    X = X / (X.norm() + 1e-7)
+    for _ in range(steps):
+        A = X @ X.T
+        B = b * A + c * (A @ A)
+        X = a * X + B @ X
+    if transposed:
+        X = X.T
+    return X
+
+
+def muon_predicate(name: str, p: torch.Tensor) -> bool:
+    """Conservative whitelist: only hidden matrices of custom transformer blocks."""
+    if not p.requires_grad or p.ndim != 2:
+        return False
+    if "transformer_blocks" not in name:
+        return False
+    if ".attn1." not in name and ".ff." not in name:
+        return False
+    if "norm" in name or name.endswith(".bias"):
+        return False
+    # category-specific banks are never inside transformer_blocks, but stay defensive
+    if "state_encoder" in name or "action_encoder" in name or "action_decoder" in name:
+        return False
+    return True
+
+
+class Muon(Optimizer):
+    """Momentum + orthogonalized-update optimizer for 2D matrices.
+
+    state per param: momentum buffer (same device/dtype as param).
+    `ns_device` controls where Newton-Schulz runs (default cuda).
+    """
+
+    def __init__(self, params: Iterable[torch.nn.Parameter], lr=3e-3, momentum=0.95,
+                 nesterov=True, ns_steps=5, ns_device="cuda"):
+        super().__init__(list(params), dict(lr=lr, momentum=momentum, nesterov=nesterov,
+                                            ns_steps=ns_steps))
+        self.ns_device = ns_device
+
+    @torch.no_grad()
+    def step(self, closure=None):  # type: ignore[override]
+        from torch.distributed.tensor import DTensor
+
+        loss = None
+        if closure is not None:
+            with torch.enable_grad():
+                loss = closure()
+        for group in self.param_groups:
+            lr, mom, nesterov = group["lr"], group["momentum"], group["nesterov"]
+            for p in group["params"]:
+                if p.grad is None:
+                    continue
+                # FSDP2 offload: work on the local shard (world=1 => full param)
+                pl = p.to_local() if isinstance(p, DTensor) else p
+                g = p.grad
+                gl = g.to_local() if isinstance(g, DTensor) else g
+                st = self.state[p]
+                if "momentum_buffer" not in st:
+                    st["momentum_buffer"] = torch.zeros_like(pl)
+                buf = st["momentum_buffer"]
+                buf.lerp_(gl, 1.0 - mom)
+                g_eff = gl.lerp_(buf, mom) if nesterov else buf
+
+                ns_dev = self.ns_device if torch.cuda.is_available() else pl.device
+                g2 = g_eff.to(ns_dev, non_blocking=True)
+                v = ns_newtonschulz5(g2, group["ns_steps"])
+                # spectral-norm-equivalent scaling (matches AdamW-friendly magnitudes)
+                v = v.to(pl.device, dtype=pl.dtype, non_blocking=True)
+                scale = 0.2 * max(pl.size(0), pl.size(1)) ** 0.5
+                pl.add_(v, alpha=-lr * scale)
+        return loss
+
+
+class MuonAdamW(torch.optim.Optimizer):
+    """Hybrid wrapper exposing .step()/.zero_grad()/state_dict() for HF Trainer loop.
+
+    Subclasses torch Optimizer so LR schedulers accept it; param_groups is the
+    concatenation of the two real optimizers' groups.
+    """
+
+    def __init__(self, muon: Muon, adamw: torch.optim.AdamW):
+        super().__init__([torch.nn.Parameter()], dict(lr=0.0))
+        self.muon, self.adamw = muon, adamw
+        self.param_groups = muon.param_groups + adamw.param_groups
+        self.defaults = {}
+
+    def zero_grad(self, set_to_none=True):
+        self.muon.zero_grad(set_to_none=set_to_none)
+        self.adamw.zero_grad(set_to_none=set_to_none)
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        self.muon.step()
+        self.adamw.step()
+
+    def state_dict(self):
+        return {"muon": self.muon.state_dict(), "adamw": self.adamw.state_dict()}
+
+    def load_state_dict(self, sd):
+        if "muon" in sd:
+            self.muon.load_state_dict(sd["muon"])
+            self.adamw.load_state_dict(sd["adamw"])
+
+
+def build_hybrid_optimizer(model, cfg):
+    """Split trainable params by muon_predicate; AdamW side keeps HF-style
+    decay/no-decay groups (biases & 1D params excluded from weight decay)."""
+    muon_params, adam_decay, adam_no_decay = [], [], []
+    for name, p in model.named_parameters():
+        if not p.requires_grad:
+            continue
+        if muon_predicate(name, p):
+            muon_params.append(p)
+        elif p.ndim <= 1 or "norm" in name.lower() or name.endswith(".bias") or "embedding" in name:
+            adam_no_decay.append(p)
+        else:
+            adam_decay.append(p)
+    n_muon = sum(p.numel() for p in muon_params)
+    logger.info("muon hybrid: muon tensors=%d (%.1fM params), adamw decay=%d no_decay=%d tensors",
+                len(muon_params), n_muon / 1e6, len(adam_decay), len(adam_no_decay))
+    muon = Muon(muon_params, lr=getattr(cfg, "muon_lr", 3e-3), momentum=0.95)
+    wd = getattr(cfg, "weight_decay", 1e-5)
+    adamw = torch.optim.AdamW(
+        [{"params": adam_decay, "weight_decay": wd},
+         {"params": adam_no_decay, "weight_decay": 0.0}],
+        lr=getattr(cfg, "learning_rate", 1e-4), foreach=False)
+    return MuonAdamW(muon, adamw)
