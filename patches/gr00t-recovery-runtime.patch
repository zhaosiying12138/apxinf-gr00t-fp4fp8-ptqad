diff --git a/gr00t/experiment/fsdp2.py b/gr00t/experiment/fsdp2.py
new file mode 100644
index 0000000..9a3444e
--- /dev/null
+++ b/gr00t/experiment/fsdp2.py
@@ -0,0 +1,177 @@
+# SPDX-License-Identifier: Apache-2.0
+# Single-GPU FSDP2 + CPU offload for GR00T N1.7 (paper project).
+# Applies torch.distributed.fsdp.fully_shard() bottom-up over the trainable
+# action head only; frozen VLM stays GPU-resident (Level-1 offload).
+#
+# Known Phase-1 verification points (do NOT assume; verify empirically):
+#  * HF Trainer must NOT use fused AdamW when params live on CPU  -> force adamw_torch
+#  * trainer eval/save callbacks touching state_dict will see DTensor -> handled via
+#    full_state_dict() helper below (v1); DCP-based resume is v2.
+import logging
+import os
+from typing import Optional
+
+import torch
+import torch.distributed as dist
+from torch.distributed.device_mesh import init_device_mesh
+from torch.distributed.fsdp import CPUOffloadPolicy, MixedPrecisionPolicy, fully_shard
+
+logger = logging.getLogger(__name__)
+
+
+def _ensure_single_rank_process_group() -> None:
+    """single-GPU FSDP2 needs a (world_size=1) process group even under plain `python`.
+    Multi-backend: CPU collectives (e.g. DTensor reduce on offloaded grads during
+    grad clipping) use gloo; CUDA mesh/all-gather uses nccl."""
+    os.environ.setdefault("MASTER_ADDR", "127.0.0.1")
+    os.environ.setdefault("MASTER_PORT", "29517")
+    if not dist.is_initialized():
+        dist.init_process_group(backend="cpu:gloo,cuda:nccl", world_size=1, rank=0)
+        logger.info("fsdp2: initialized world_size=1 multi-backend process group")
+
+
+def apply_fsdp2(model, training_cfg) -> None:
+    """Bottom-up fully_shard over the action head transformer blocks.
+
+    Must be called AFTER pipeline.return_model() and BEFORE Gr00tTrainer creates
+    its optimizer (satisfied by the experiment.py insertion point).
+    """
+    _ensure_single_rank_process_group()
+    # CPUOffloadPolicy requires parameters materialized on CPU at fully_shard
+    # time; Trainer/Accelerate re-placement is disabled via device_placement
+    # patch, and FSDP2 pre-forward sync manages H2D itself.
+    mesh = init_device_mesh("cuda", (1,))
+
+    offload_policy = CPUOffloadPolicy(pin_memory=getattr(training_cfg, "fsdp2_pin_memory", True))
+    mp_policy = MixedPrecisionPolicy(
+        param_dtype=torch.bfloat16,
+        reduce_dtype=torch.float32,
+    )
+    kw = dict(
+        mesh=mesh,
+        reshard_after_forward=getattr(training_cfg, "fsdp2_reshard_after_forward", True),
+        mp_policy=mp_policy,
+        offload_policy=offload_policy,
+    )
+
+    action_head = model.action_head
+    # CPUOffloadPolicy contract: trainable params must be CPU-materialized at
+    # fully_shard time (pipeline setup may have moved them to cuda).
+    action_head.to("cpu")
+    n_units = 0
+
+    # VL self-attention blocks
+    vl_sa = getattr(action_head, "vl_self_attention", None)
+    if vl_sa is not None and hasattr(vl_sa, "transformer_blocks"):
+        for blk in vl_sa.transformer_blocks:
+            fully_shard(blk, **kw)
+            n_units += 1
+
+    # DiT blocks
+    dit = getattr(action_head, "model", None)
+    if dit is not None and hasattr(dit, "transformer_blocks"):
+        for blk in dit.transformer_blocks:
+            fully_shard(blk, **kw)
+            n_units += 1
+
+    # root of the trainable action side collects encoders/decoder/vlln/pos-embed
+    fully_shard(action_head, **kw)
+    n_units += 1
+
+    # Frozen VLM is NOT sharded; keep it GPU-resident (Level-1 offload design).
+    # Only non-DTensor modules may be moved after fully_shard.
+    for attr in ("backbone", "vlm", "model_backbone"):
+        sub = getattr(model, attr, None)
+        if isinstance(sub, torch.nn.Module) and attr == "backbone":
+            sub.to("cuda")
+            logger.info("fsdp2: frozen backbone moved to cuda (GPU-resident)")
+
+    if getattr(training_cfg, "fsdp2_activation_checkpointing", False):
+        # Phase-2 selective AC granularity: "both" (default) | "dit" | "vlsa"
+        ac_targets = getattr(training_cfg, "fsdp2_ac_targets", "both")
+        if ac_targets == "dit":
+            apply_selective_ac(action_head, targets=("model",))
+        elif ac_targets == "vlsa":
+            apply_selective_ac(action_head, targets=("vl_self_attention",))
+        else:
+            apply_selective_ac(action_head, targets=("vl_self_attention", "model"))
+
+    # TEMP DIAG: where do root-unit sharded params live right after apply?
+    import os as _os
+    if _os.environ.get("FSDP2_DEBUG"):
+        for n_, p_ in action_head.named_parameters():
+            loc = p_.to_local() if hasattr(p_, "to_local") else p_
+            if "state_encoder" in n_ or "vlln" in n_:
+                logger.warning("DIAG post-apply %s -> %s", n_, loc.device)
+    # fused AdamW requires CUDA params; CPU-offloaded params must use the
+    # non-fused path. experiment.py also rewrites TrainingArguments.optim.
+    logger.info(
+        "fsdp2: applied fully_shard to %d units (reshard_after_forward=%s, pin=%s)",
+        n_units, kw["reshard_after_forward"], offload_policy.pin_memory,
+    )
+
+
+def apply_selective_ac(action_head, targets=("vl_self_attention", "model")) -> int:
+    """Per-block activation checkpointing on custom DiT blocks (use_reentrant=False,
+    required for FSDP2 compatibility). Returns number of wrapped blocks."""
+    import torch.utils.checkpoint as cp
+
+    n = 0
+    for attr in targets:
+        sub = getattr(action_head, attr, None)
+        if sub is None or not hasattr(sub, "transformer_blocks"):
+            continue
+        for blk in sub.transformer_blocks:
+            if getattr(blk, "_fsdp2_ac_wrapped", False):
+                continue
+            orig_forward = blk.forward
+
+            def make_ckpt(fwd, owner):
+                def ckpt_forward(*args, **kwargs):
+                    if torch.is_grad_enabled() and owner.training:
+                        return cp.checkpoint(fwd, *args, use_reentrant=False, **kwargs)
+                    return fwd(*args, **kwargs)
+                return ckpt_forward
+
+            blk.forward = make_ckpt(orig_forward, blk)  # bind owner block, avoid late binding
+            blk._fsdp2_ac_wrapped = True
+            n += 1
+    logger.info("fsdp2: selective activation checkpointing on %d blocks", n)
+    return n
+
+
+def full_state_dict(model):
+    """CPU full (non-DTensor) state dict for saving, world_size=1."""
+    from torch.distributed.tensor import DTensor
+
+    sd = model.state_dict()
+    out = {}
+    for k, v in sd.items():
+        if isinstance(v, DTensor):
+            v = v.full_tensor()
+        out[k] = v.detach().to("cpu", copy=True)
+    return out
+
+
+def save_fsdp2_model(model, out_dir: str) -> None:
+    """Save without transformers' save_pretrained (its TP-plan probe crashes on
+    DTensor params). Writes config + single-file safetensors."""
+    import os
+
+    from safetensors.torch import save_file
+
+    os.makedirs(out_dir, exist_ok=True)
+    sd = full_state_dict(model)
+    model.config.save_pretrained(out_dir)
+    save_file(sd, os.path.join(out_dir, "model.safetensors"))
+    logger.info("fsdp2: saved full model (%d tensors) to %s", len(sd), out_dir)
+
+
+def patch_trainer_save() -> None:
+    """Make Trainer._save / final save DTensor-safe for the fsdp2 path."""
+    import transformers.trainer as _tt
+
+    def _fsdp2_save(trainer_self, output_dir, state_dict=None):
+        save_fsdp2_model(trainer_self.model, str(output_dir))
+
+    _tt.Trainer._save = _fsdp2_save
