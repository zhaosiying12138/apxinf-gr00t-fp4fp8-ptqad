--- a/crates/apxinf-cuda/src/kernels/gemm/fp8.rs
+++ b/crates/apxinf-cuda/src/kernels/gemm/fp8.rs
@@ -457,7 +457,14 @@ pub fn gemm_fp8(
 
 fn geglu_tuning_key(ctx: &CudaContext, m: usize, full_n: usize, k: usize) -> GemmTuningKey {
     let mut key = tuning_key(ctx, m, full_n, k);
-    key.output_dtype = TuningDType::F8E4M3;
+    // sm_120 (GeForce Blackwell) cuBLASLt has no E4M3-OUTPUT fp8 GEMM (probed:
+    // heuristic status 15); keep the Thor (sm_110) fp8-output path, fall back
+    // to f16 output elsewhere (verified working, see fp4vla spike/fp8_probe.cu).
+    key.output_dtype = if ctx.caps().sm == 110 {
+        TuningDType::F8E4M3
+    } else {
+        TuningDType::F16
+    };
     key.epilogue = Epilogue::GeGlu;
     key
 }
