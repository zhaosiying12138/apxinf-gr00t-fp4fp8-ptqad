diff --git a/crates/apxinf-cuda/src/kernels/fp4.rs b/crates/apxinf-cuda/src/kernels/fp4.rs
new file mode 100644
index 0000000..49963ec
--- /dev/null
+++ b/crates/apxinf-cuda/src/kernels/fp4.rs
@@ -0,0 +1,114 @@
+//! NVFP4 linear operator: online-quantize an F16 activation to E2M1+swizzled
+//! E4M3 scales, then run the block-scaled GEMM against an fp4 weight
+//! (packed + physical-swizzle scales, from fp4vla offline artifacts).
+//!
+//! The activation secondary scale is 1; the artifact weight secondary scale
+//! is applied as GEMM alpha. Output is contiguous row-major [M,N].
+//! See doc/fp4-linear-contract.md for scope and the composition test.
+
+use crate::buffer::CudaBuffer;
+use crate::context::CudaContext;
+use crate::ffi;
+use crate::ffi::cudaStream_t;
+
+// public thin wrappers so model crates can reach the private ffi module casts
+pub fn bf16_to_f16_ffi(x: *const core::ffi::c_void, y: *mut core::ffi::c_void,
+                       n: usize, stream: cudaStream_t) -> i32 {
+    unsafe { ffi::apxinf_bf16_to_f16(x, y, n, stream) }
+}
+pub fn f16_to_bf16_ffi(x: *const core::ffi::c_void, y: *mut core::ffi::c_void,
+                       n: usize, stream: cudaStream_t) -> i32 {
+    unsafe { ffi::apxinf_f16_to_bf16(x, y, n, stream) }
+}
+use apxinf_core::{DType, Error, Result, Shape, Tensor};
+
+/// A single NVFP4 weight matrix resident on device (borrowed views into the
+/// artifact loader's buffers).
+pub struct Fp4WeightView<'a> {
+    pub packed: &'a CudaBuffer,
+    pub scale: &'a CudaBuffer,
+    pub tscale: f32, // FP32 secondary scale from the weight artifact
+    pub rows: usize, // N of the GEMM (out_features)
+    pub k: usize,
+}
+
+/// y[m, n] = x[m, k] @ w[n, k]^T  with NVFP4 weight and online-quantized
+/// NVFP4 activation; output F16. x must be F16, contiguous, m*k.
+pub fn fp4_linear(ctx: &CudaContext, x: &Tensor, w: &Fp4WeightView<'_>) -> Result<Tensor> {
+    let dims = x.shape().dims();
+    if dims.len() != 2 {
+        return Err(Error::Other(format!("fp4_linear expects 2-D input, got {dims:?}")));
+    }
+    let (m, k) = (dims[0], dims[1]);
+    if k != w.k || k % 16 != 0 || m == 0 || w.rows == 0 || k == 0 {
+        return Err(Error::Other(format!(
+            "fp4_linear shape mismatch: x {m}x{k} vs weight {}x{}",
+            w.rows, w.k
+        )));
+    }
+    if x.dtype() != DType::F16 {
+        return Err(Error::Other(format!(
+            "fp4_linear expects F16 input, got {:?}",
+            x.dtype()
+        )));
+    }
+
+    if !w.tscale.is_finite() || w.tscale <= 0.0 {
+        return Err(Error::Other("fp4_linear expects a finite positive weight tscale".into()));
+    }
+    let expected_scale_bytes = 512 * ((k / 16 + 3) / 4) * ((w.rows + 127) / 128);
+    if w.packed.len() != w.rows * k / 2 || w.scale.len() != expected_scale_bytes {
+        return Err(Error::Other("fp4_linear weight buffer size mismatch".into()));
+    }
+    let packed_bytes = CudaBuffer::alloc_on(ctx, m * k / 2).map_err(Error::Cuda)?;
+    let kb = k / 16;
+    let scale_bytes = 512 * ((kb + 3) / 4) * ((m + 127) / 128);
+    let scale_buf = CudaBuffer::alloc_on(ctx, scale_bytes).map_err(Error::Cuda)?;
+
+    let x_buf = CudaBuffer::from_tensor(x).map_err(Error::Cuda)?;
+    unsafe {
+        let e = ffi::apxinf_nvfp4_quantize_activation(
+            x_buf.ptr() as *const _,
+            packed_bytes.ptr() as *mut _,
+            scale_buf.ptr() as *mut _,
+            m as i32,
+            k as i32,
+            ctx.stream().handle() as *mut _,
+        );
+        if e != 0 {
+            return Err(Error::Other(format!(
+                "nvfp4 activation quantize failed: cudaError {e}"
+            )));
+        }
+    }
+
+    let out = CudaBuffer::alloc_on(ctx, m * w.rows * 2).map_err(Error::Cuda)?;
+    let ws = CudaBuffer::alloc_on(ctx, 64 << 20).map_err(Error::Cuda)?;
+    unsafe {
+        let st = ffi::apxinf_fp4_gemm_rowmajor_scaled_f16(
+            m as i32,
+            w.rows as i32,
+            k as i32,
+            packed_bytes.ptr() as *const _,
+            w.packed.ptr() as *const _,
+            scale_buf.ptr() as *const _,
+            w.scale.ptr() as *const _,
+            w.tscale,
+            out.ptr() as *mut _,
+            ws.ptr() as *mut _,
+            ws.len(),
+            ctx.stream().handle() as *mut _,
+        );
+        if st != 0 {
+            return Err(Error::Other(format!(
+                "nvfp4 gemm failed: cublasStatus {st}"
+            )));
+        }
+    }
+    Ok(out.into_tensor(Shape::new(vec![m, w.rows]), DType::F16))
+}
+
+#[cfg(test)]
+mod fp4_contract_tests {
+    include!("fp4_contract_tests.rs");
+}
