diff --git a/crates/apxinf-cuda/src/kernels/fp4.rs b/crates/apxinf-cuda/src/kernels/fp4.rs
new file mode 100644
index 0000000..d6b65d9
--- /dev/null
+++ b/crates/apxinf-cuda/src/kernels/fp4.rs
@@ -0,0 +1,179 @@
+//! NVFP4 linear operator: online-quantize an F16 activation to E2M1+swizzled
+//! E4M3 scales, then run the block-scaled GEMM against an fp4 weight
+//! (packed + physical-swizzle scales, from fp4vla offline artifacts).
+//!
+//! The activation secondary scale is 1; the artifact weight secondary scale
+//! is applied as GEMM alpha. Output is contiguous row-major [M,N].
+//! See doc/fp4-linear-contract.md for scope and the composition test.
+
+use crate::buffer::CudaBuffer;
+use crate::context::CudaContext;
+use crate::ffi;
+use crate::ffi::cudaStream_t;
+
+// public thin wrappers so model crates can reach the private ffi module casts
+pub fn bf16_to_f16_ffi(x: *const core::ffi::c_void, y: *mut core::ffi::c_void,
+                       n: usize, stream: cudaStream_t) -> i32 {
+    unsafe { ffi::apxinf_bf16_to_f16(x, y, n, stream) }
+}
+pub fn f16_to_bf16_ffi(x: *const core::ffi::c_void, y: *mut core::ffi::c_void,
+                       n: usize, stream: cudaStream_t) -> i32 {
+    unsafe { ffi::apxinf_f16_to_bf16(x, y, n, stream) }
+}
+use apxinf_core::{DType, Device, Error, Result, Shape, Tensor};
+
+/// Conservative arena reservation for one BF16 -> FP4 -> BF16 projection.
+/// Each of the five intermediates is independently aligned; the 64 MiB GEMM
+/// scratch is context-owned and deliberately not repeated in this sum.
+pub fn fp4_graph_buffer_bytes(m: usize, n: usize, k: usize) -> Result<usize> {
+    let overflow = || Error::Other("FP4 graph buffer size overflow".into());
+    if m == 0 || n == 0 || k == 0 || k % 16 != 0 {
+        return Err(Error::Other("FP4 graph buffer shape must be positive and K divisible by 16".into()));
+    }
+    let mk = m.checked_mul(k).ok_or_else(overflow)?;
+    let mn = m.checked_mul(n).ok_or_else(overflow)?;
+    let scale = (k / 16).checked_add(3).ok_or_else(overflow)? / 4;
+    let panels = m.checked_add(127).ok_or_else(overflow)? / 128;
+    let scale = scale.checked_mul(panels).and_then(|x| x.checked_mul(512)).ok_or_else(overflow)?;
+    let sizes = [mk.checked_mul(2).ok_or_else(overflow)?, mk / 2, scale,
+                 mn.checked_mul(2).ok_or_else(overflow)?, mn.checked_mul(2).ok_or_else(overflow)?];
+    sizes.into_iter().try_fold(0usize, |sum, size| {
+        let aligned = size.checked_add(255).ok_or_else(overflow)? & !255;
+        sum.checked_add(aligned).ok_or_else(overflow)
+    })
+}
+
+fn cast_16(ctx: &CudaContext, x: &Tensor, input: DType, output: DType) -> Result<Tensor> {
+    if x.dtype() != input || x.device() != Device::Cuda(ctx.device_id()) {
+        return Err(Error::Other("FP4 cast requires the declared dtype on the context device".into()));
+    }
+    let n = x.shape().dims().iter().try_fold(1usize, |v, d| v.checked_mul(*d))
+        .ok_or_else(|| Error::Other("FP4 cast element count overflow".into()))?;
+    let bytes = n.checked_mul(2).ok_or_else(|| Error::Other("FP4 cast byte count overflow".into()))?;
+    let out = crate::workspace::output_buffer(ctx, bytes)?;
+    let src = CudaBuffer::from_tensor(x).map_err(Error::Cuda)?;
+    let error = if input == DType::BF16 {
+        bf16_to_f16_ffi(src.ptr(), out.ptr(), n, ctx.stream().handle())
+    } else {
+        f16_to_bf16_ffi(src.ptr(), out.ptr(), n, ctx.stream().handle())
+    };
+    ffi::check_cuda(error).map_err(Error::Cuda)?;
+    Ok(out.into_tensor(Shape::new(x.shape().dims().to_vec()), output))
+}
+
+/// Same arithmetic as the hybrid model path, with all intermediates owned by
+/// the active graph arena during preparation/capture.
+pub fn fp4_linear_bf16(ctx: &CudaContext, x: &Tensor, w: &Fp4WeightView<'_>) -> Result<Tensor> {
+    let input = cast_16(ctx, x, DType::BF16, DType::F16)?;
+    let output = fp4_linear(ctx, &input, w)?;
+    cast_16(ctx, &output, DType::F16, DType::BF16)
+}
+
+/// A single NVFP4 weight matrix resident on device (borrowed views into the
+/// artifact loader's buffers).
+pub struct Fp4WeightView<'a> {
+    pub packed: &'a CudaBuffer,
+    pub scale: &'a CudaBuffer,
+    pub tscale: f32, // FP32 secondary scale from the weight artifact
+    pub rows: usize, // N of the GEMM (out_features)
+    pub k: usize,
+}
+
+/// y[m, n] = x[m, k] @ w[n, k]^T  with NVFP4 weight and online-quantized
+/// NVFP4 activation; output F16. x must be F16, contiguous, m*k.
+pub fn fp4_linear(ctx: &CudaContext, x: &Tensor, w: &Fp4WeightView<'_>) -> Result<Tensor> {
+    let dims = x.shape().dims();
+    if dims.len() != 2 {
+        return Err(Error::Other(format!("fp4_linear expects 2-D input, got {dims:?}")));
+    }
+    let (m, k) = (dims[0], dims[1]);
+    if k != w.k || k % 16 != 0 || m == 0 || w.rows == 0 || k == 0 {
+        return Err(Error::Other(format!(
+            "fp4_linear shape mismatch: x {m}x{k} vs weight {}x{}",
+            w.rows, w.k
+        )));
+    }
+    if x.dtype() != DType::F16 {
+        return Err(Error::Other(format!(
+            "fp4_linear expects F16 input, got {:?}",
+            x.dtype()
+        )));
+    }
+
+    if !w.tscale.is_finite() || w.tscale <= 0.0 {
+        return Err(Error::Other("fp4_linear expects a finite positive weight tscale".into()));
+    }
+    let expected_scale_bytes = 512 * ((k / 16 + 3) / 4) * ((w.rows + 127) / 128);
+    if w.packed.len() != w.rows * k / 2 || w.scale.len() != expected_scale_bytes {
+        return Err(Error::Other("fp4_linear weight buffer size mismatch".into()));
+    }
+    let packed_bytes = crate::workspace::output_buffer(ctx, m * k / 2)?;
+    let kb = k / 16;
+    let scale_bytes = 512 * ((kb + 3) / 4) * ((m + 127) / 128);
+    let scale_buf = crate::workspace::output_buffer(ctx, scale_bytes)?;
+
+    let x_buf = CudaBuffer::from_tensor(x).map_err(Error::Cuda)?;
+    unsafe {
+        let e = ffi::apxinf_nvfp4_quantize_activation(
+            x_buf.ptr() as *const _,
+            packed_bytes.ptr() as *mut _,
+            scale_buf.ptr() as *mut _,
+            m as i32,
+            k as i32,
+            ctx.stream().handle() as *mut _,
+        );
+        if e != 0 {
+            return Err(Error::Other(format!(
+                "nvfp4 activation quantize failed: cudaError {e}"
+            )));
+        }
+    }
+
+    let out = crate::workspace::output_buffer(ctx, m * w.rows * 2)?;
+    let may_prepare = crate::workspace::may_prepare_native_resources();
+    let ws = ctx.fp4_workspace(may_prepare).map_err(Error::Cuda)?;
+    unsafe {
+        if may_prepare {
+            ffi::check_cublas(ffi::apxinf_fp4_prepare_rowmajor_f16(
+                m as i32, w.rows as i32, k as i32,
+                scale_buf.ptr(), w.scale.ptr(), ws.len(), ctx.stream().handle(),
+            )).map_err(Error::Cuda)?;
+        }
+        let st = ffi::apxinf_fp4_gemm_rowmajor_prepared_f16(
+            m as i32,
+            w.rows as i32,
+            k as i32,
+            packed_bytes.ptr() as *const _,
+            w.packed.ptr() as *const _,
+            scale_buf.ptr() as *const _,
+            w.scale.ptr() as *const _,
+            w.tscale,
+            out.ptr() as *mut _,
+            ws.ptr() as *mut _,
+            ws.len(),
+            ctx.stream().handle() as *mut _,
+        );
+        if st != 0 {
+            return Err(Error::Other(format!(
+                "nvfp4 gemm failed: cublasStatus {st}"
+            )));
+        }
+    }
+    Ok(out.into_tensor(Shape::new(vec![m, w.rows]), DType::F16))
+}
+
+#[cfg(test)]
+mod cpu_tests {
+    #[test]
+    fn fp4_graph_budget_cpu() {
+        assert_eq!(super::fp4_graph_buffer_bytes(2, 128, 16).unwrap(), 2048);
+        assert!(super::fp4_graph_buffer_bytes(0, 128, 16).is_err());
+        assert!(super::fp4_graph_buffer_bytes(2, 128, 17).is_err());
+        assert!(super::fp4_graph_buffer_bytes(usize::MAX, 128, 16).is_err());
+    }
+}
+
