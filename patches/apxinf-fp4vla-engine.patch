+//! Hybrid BF16 + NVFP4 π0.5 topology (fp4 engine path step 3b).
+//!
+//! Design: keep the BF16 executor's weight layout and free-function topology;
+//! route each Linear's GEMM through `gemm_maybe_fp4`, which uses the NVFP4
+//! artifact tensor when present (online-quantized activation + block-scaled
+//! fp4 GEMM, F16 out) and falls back to BF16 otherwise (exemption layers:
+//! embeddings, norms, heads, first/last — per the sensitivity grid).
+//!
+//! Intermediate tensors stay BF16 (engine dtype); each fp4 site pays one
+//! bf16->f16 cast (adapter kernel) before quantization.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use apxinf_core::{DType, Error, Result, Shape, Tensor};
+
+use crate::pi05::backend::{kernels, Context, RuntimeBackend};
+use crate::pi05::model::blocks::bf16::{
+    language_layer_bf16, vision_layer_bf16, vision_patch_embed_bf16,
+};
+use crate::pi05::{Bf16Weights, GemmaVariantConfig, Pi05Config};
+
+use crate::pi05::fp4_weights::{Fp4DeviceWeight, Fp4DeviceWeights};
+use apxinf_cuda::buffer::CudaBuffer;
+
+/// name-keyed fp4 tensors loaded from an offline artifact.
+pub struct Fp4TensorMap(pub Arc<Fp4DeviceWeights>);
+
+impl Fp4TensorMap {
+    pub fn get(&self, name: &str) -> Option<&Fp4DeviceWeight> {
+        self.0.get(name)
+    }
+}
+
+fn bf16_to_f16(ctx: &Context, x: &Tensor) -> Result<Tensor> {
+    let dims = x.shape().dims();
+    let n: usize = dims.iter().product();
+    let dst = CudaBuffer::alloc_on(ctx, n * 2).map_err(Error::Cuda)?;
+    let src = CudaBuffer::from_tensor(x).map_err(Error::Cuda)?;
+    unsafe {
+        let e = apxinf_cuda::ffi::apxinf_bf16_to_f16(
+            src.ptr() as *const _,
+            dst.ptr() as *mut _,
+            n,
+            ctx.stream().handle() as *mut _,
+        );
+        if e != 0 {
+            return Err(Error::Other(format!("bf16->f16 cast cudaError {e}")));
+        }
+    }
+    dst.into_tensor(Shape::new(dims.to_vec()), DType::F16)
+}
+
+/// The routing heart of the hybrid topology: fp4 GEMM when the weight has an
+/// artifact tensor, BF16 GEMM otherwise.
+pub fn gemm_maybe_fp4(
+    ctx: &Context,
+    x_bf16: &Tensor,
+    weight_bf16: &Tensor,
+    fp4: Option<&Fp4DeviceWeight>,
+) -> Result<Tensor> {
+    let Some(w4) = fp4 else {
+        return kernels::gemm::bf16(ctx, x_bf16, weight_bf16);
+    };
+    let x_f16 = bf16_to_f16(ctx, x_bf16)?;
+    let view = apxinf_cuda::kernels::fp4::Fp4WeightView {
+        packed: &w4.packed,
+        scale: &w4.scale,
+        rows: w4.rows,
+        k: w4.k,
+    };
+    let out_f16 = apxinf_cuda::kernels::fp4::fp4_linear(ctx, &x_f16, &view)?;
+    // back to BF16 for the rest of the BF16 topology
+    let n: usize = out_f16.shape().dims().iter().product();
+    let dst = CudaBuffer::alloc_on(ctx, n * 2).map_err(Error::Cuda)?;
+    let src = CudaBuffer::from_tensor(&out_f16).map_err(Error::Cuda)?;
+    unsafe {
+        // f16->bf16: reuse the byte-symmetric path via a second kernel entry
+        let e = apxinf_cuda::ffi::apxinf_f16_to_bf16(
+            src.ptr() as *const _,
+            dst.ptr() as *mut _,
+            n,
+            ctx.stream().handle() as *mut _,
+        );
+        if e != 0 {
+            return Err(Error::Other(format!("f16->bf16 cast cudaError {e}")));
+        }
+    }
+    Ok(dst.into_tensor(Shape::new(out_f16.shape().dims().to_vec()), DType::BF16))
+}
+
+/// Hybrid blocks: BF16 weights + optional fp4 tensors keyed by checkpoint name.
+/// 3b scope: struct + routing + vision path; language/action layers follow the
+/// same pattern in the next increment (they call the same helper).
+pub struct Fp4Blocks {
+    pub(in crate::pi05::model) backend: Arc<RuntimeBackend>,
+    pub(in crate::pi05::model) config: Arc<Pi05Config>,
+    pub(in crate::pi05::model) weights: Arc<Bf16Weights>,
+    pub(in crate::pi05::model) fp4: Fp4TensorMap,
+}
+
+impl Fp4Blocks {
+    pub fn new(
+        backend: Arc<RuntimeBackend>,
+        config: Arc<Pi05Config>,
+        weights: Arc<Bf16Weights>,
+        fp4: Arc<Fp4DeviceWeights>,
+    ) -> Result<Self> {
+        config.validate()?;
+        Ok(Self { backend, config, weights, fp4: Fp4TensorMap(fp4) })
+    }
+
+    fn ctx(&self) -> &Context {
+        self.backend.context()
+    }
+
+    fn w4(&self, name: &str) -> Option<&Fp4DeviceWeight> {
+        self.fp4.get(name)
+    }
+
+    /// Vision prefix with fp4-routed projector; patch embed and ViT layers
+    /// stay BF16 in this increment (vision is cache-friendly and often on the
+    /// exemption table anyway — the sensitivity grid decides).
+    pub fn encode_vision(&self, patches: &Tensor) -> Result<Tensor> {
+        let mut hidden = vision_patch_embed_bf16(
+            self.ctx(),
+            &self.weights.patch_embedding,
+            &self.weights.position_embedding,
+            patches,
+            self.config.patches_per_view(),
+        )?;
+        for layer in &self.weights.vision_layers {
+            hidden = vision_layer_bf16(
+                self.ctx(),
+                layer,
+                &hidden,
+                self.config.patches_per_view(),
+                self.config.vision_heads,
+                self.config.vision_head_dim,
+                self.config.layer_norm_eps,
+            )?;
+        }
+        let hidden = kernels::norm::layer_bf16(
+            self.ctx(),
+            &hidden,
+            &self.weights.vision_post_norm.weight,
+            &self.weights.vision_post_norm.bias,
+            self.config.layer_norm_eps,
+        )?;
+        // routed: multimodal projector (name from the pi05 checkpoint tree)
+        let projected = gemm_maybe_fp4(
+            self.ctx(),
+            &hidden,
+            &self.weights.multimodal_projector.weight,
+            self.w4("paligemma_with_expert.paligemma.multi_modal_projector.weight"),
+        )?;
+        kernels::elementwise::bias_bf16(
+            self.ctx(),
+            &projected,
+            self.weights.multimodal_projector.bias.as_ref(),
+        )
+    }
+}
+
+use crate::pi05::{Bf16DeviceLanguageLayer, Bf16LanguageLayerOutput};
+
+/// Language layer with per-GEMM fp4 routing. `prefix` is the checkpoint
+/// subtree for this layer (e.g. "paligemma_with_expert.gemma_expert.model.layers.{i}").
+/// Gemma packing note: the BF16 executor fuses qkv/gate_up into packed weights;
+/// when an fp4 artifact carries the UNPACKED checkpoint names (k/q/v/gate/up
+/// separately), those packed sites stay BF16 in this increment — the artifact
+/// generator will emit packed names to unlock them (see quant/packed_names.py TODO).
+#[allow(clippy::too_many_arguments)]
+pub fn language_layer_fp4(
+    ctx: &Context,
+    config: GemmaVariantConfig,
+    weights: &Bf16DeviceLanguageLayer,
+    fp4: &Fp4TensorMap,
+    prefix: &str,
+    input: &Tensor,
+    compute_tail: bool,
+    position_offset: usize,
+    rms_eps: f32,
+    rope_theta: f32,
+) -> Result<Bf16LanguageLayerOutput> {
+    let normalized = kernels::norm::rms_bf16(ctx, input, &weights.input_norm_scale, rms_eps)?;
+    let qkv = gemm_maybe_fp4(
+        ctx, &normalized, &weights.qkv.weight, fp4.get(&format!("{prefix}.qkv.weight")),
+    )?;
+    let qkv = kernels::rope::split_qkv_apply_bf16(
+        ctx, &qkv, weights.qkv.bias.as_ref(), config.num_heads,
+        config.num_kv_heads, config.head_dim, rope_theta, position_offset,
+    )?;
+    let tokens = input.shape().dims()[0];
+    if !compute_tail {
+        return Ok(Bf16LanguageLayerOutput {
+            hidden: input.clone(),
+            key: qkv.key_2d(tokens, config.head_dim)?,
+            value: qkv.value_2d(tokens, config.head_dim)?,
+        });
+    }
+    let attention = kernels::attention::mqa_bf16(ctx, &qkv.q, &qkv.k, &qkv.v, tokens)?
+        .reshape(vec![tokens, config.num_heads * config.head_dim])?;
+    let projected = gemm_maybe_fp4(
+        ctx, &attention, &weights.output.weight,
+        fp4.get(&format!("{prefix}.self_attn.o_proj.weight")),
+    )?;
+    let fused = kernels::fused::bias_residual_rms_bf16(
+        ctx, &projected, weights.output.bias.as_ref(), input,
+        &weights.post_attention_norm_scale, rms_eps,
+    )?;
+    // gate_up: fp4 route = plain GEMM + separate geglu (fused BF16 path only
+    // for BF16 weights); BF16 fallback keeps the fused kernel.
+    let activated = match fp4.get(&format!("{prefix}.gate_up.weight")) {
+        Some(_) => {
+            let gu = gemm_maybe_fp4(
+                ctx, &fused.normalized, &weights.gate_up.weight,
+                fp4.get(&format!("{prefix}.gate_up.weight")),
+            )?;
+            kernels::activation::geglu_bf16(ctx, &gu)?
+        }
+        None => kernels::gemm::bf16_geglu_fused(
+            ctx, &fused.normalized, &weights.gate_up.weight,
+            weights.gate_up.bf16_dual_geglu_interleaved,
+            weights.gate_up.bf16_dual_geglu_auto_interleaved.as_ref(),
+            weights.gate_up.bf16_sm89_geglu_interleaved.as_ref(),
+        )?,
+    };
+    let projected = gemm_maybe_fp4(
+        ctx, &activated, &weights.down.weight,
+        fp4.get(&format!("{prefix}.mlp.down_proj.weight")),
+    )?;
+    let hidden = kernels::fused::bias_residual_bf16(
+        ctx, &projected, weights.down.bias.as_ref(), &fused.hidden,
+    )?;
+    Ok(Bf16LanguageLayerOutput {
+        hidden,
+        key: qkv.key_2d(tokens, config.head_dim)?,
+        value: qkv.value_2d(tokens, config.head_dim)?,
+    })
+}
+
+use crate::pi05::{Bf16DeviceActionLayer, Bf16ActionLayerOutput};
+
+/// Action layer with fp4 routing; action-head names (action_in_proj /
+/// action_out_proj / action_layers.N.*) are directly routable.
+#[allow(clippy::too_many_arguments)]
+pub fn action_layer_fp4(
+    ctx: &Context,
+    config: GemmaVariantConfig,
+    weights: &Bf16DeviceActionLayer,
+    fp4: &Fp4TensorMap,
+    prefix: &str,
+    input: &Tensor,
+    attention_normalized: Option<&Tensor>,
+    attention_modulation: &Tensor,
+    mlp_modulation: &Tensor,
+    next_norm_modulation: &Tensor,
+    prefix_k: &Tensor,
+    prefix_v: &Tensor,
+    position_offset: usize,
+    rms_eps: f32,
+    rope_theta: f32,
+) -> Result<Bf16ActionLayerOutput> {
+    let normalized = match attention_normalized {
+        Some(value) => value.clone(),
+        None => kernels::norm::adaptive_rms_bf16(ctx, input, attention_modulation, rms_eps)?,
+    };
+    let qkv = gemm_maybe_fp4(
+        ctx, &normalized, &weights.qkv.weight, fp4.get(&format!("{prefix}.qkv.weight")),
+    )?;
+    let q = kernels::rope::apply_q_write_kv_bf16(
+        ctx, &qkv, weights.qkv.bias.as_ref(), config.num_heads,
+        config.num_kv_heads, config.head_dim, rope_theta,
+        position_offset, prefix_k, prefix_v, position_offset,
+    )?;
+    let attention = kernels::attention::mqa_bf16(
+        ctx, &q, prefix_k, prefix_v, position_offset + input.shape().dims()[0],
+    )?
+    .reshape(vec![
+        input.shape().dims()[0],
+        config.num_heads * config.head_dim,
+    ])?;
+    let projected = gemm_maybe_fp4(
+        ctx, &attention, &weights.output.weight,
+        fp4.get(&format!("{prefix}.self_attn.o_proj.weight")),
+    )?;
+    let fused = kernels::fused::adaptive_gate_residual_rms_bf16(
+        ctx, &projected, input, attention_modulation, mlp_modulation, rms_eps,
+    )?;
+    let activated = match fp4.get(&format!("{prefix}.gate_up.weight")) {
+        Some(_) => {
+            let gu = gemm_maybe_fp4(
+                ctx, &fused.normalized, &weights.gate_up.weight,
+                fp4.get(&format!("{prefix}.gate_up.weight")),
+            )?;
+            kernels::activation::geglu_bf16(ctx, &gu)?
+        }
+        None => kernels::gemm::bf16_geglu_fused(
+            ctx, &fused.normalized, &weights.gate_up.weight,
+            weights.gate_up.bf16_dual_geglu_interleaved,
+            weights.gate_up.bf16_dual_geglu_auto_interleaved.as_ref(),
+            weights.gate_up.bf16_sm89_geglu_interleaved.as_ref(),
+        )?,
+    };
+    let projected = gemm_maybe_fp4(
+        ctx, &activated, &weights.down.weight,
+        fp4.get(&format!("{prefix}.mlp.down_proj.weight")),
+    )?;
+    let fused = kernels::fused::adaptive_gate_residual_rms_bf16(
+        ctx, &projected, &fused.hidden, mlp_modulation, next_norm_modulation, rms_eps,
+    )?;
+    Ok(Bf16ActionLayerOutput {
+        hidden: fused.hidden,
+        next_normalized: fused.normalized,
+    })
+}
