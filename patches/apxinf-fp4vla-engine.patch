 }
+
+
+pub type cublasLtHandle_t = *mut core::ffi::c_void;
+
+// NVFP4 block-scaled GEMM (fp4vla): E2M1 x E2M1 -> F16, per-16 E4M3 scales in
+// the cuBLASLt VEC16_UE4M3 swizzled layout (see adapters/cublaslt_fp4_adapter.cu).
+extern "C" {
+    pub fn apxinf_fp4_gemm_f16(
+        lt: cublasLtHandle_t,
+        m: i32,
+        n: i32,
+        k: i32,
+        a_packed: *const core::ffi::c_void,
+        b_packed: *const core::ffi::c_void,
+        a_scale_swz: *const core::ffi::c_void,
+        b_scale_swz: *const core::ffi::c_void,
+        c: *mut core::ffi::c_void,
+        workspace: *mut core::ffi::c_void,
+        workspace_bytes: usize,
+        stream: cudaStream_t,
+    ) -> cublasStatus_t;
+    pub fn apxinf_fp4_scale_buffer_bytes(rows: i32, k: i32) -> usize;
+}
diff --git a/crates/apxinf-cuda/src/kernels/gemm/fp8.rs b/crates/apxinf-cuda/src/kernels/gemm/fp8.rs
