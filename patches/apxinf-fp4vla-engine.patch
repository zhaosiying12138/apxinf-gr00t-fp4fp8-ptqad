@@ -0,0 +1,67 @@
+//! Minimal full-checkpoint NVFP4 eager/RequireGraph gate: one graph arena only.
+//! GPU-exclusive execution is required; compilation does not run inference.
+use std::path::PathBuf;
+
+use apxinf_core::{DType, Device, Tensor};
+use apxinf_model::{
+    AutoModel, ExecutionMode, ExecutionPolicy, LoadOptions, Observation, Pi05Config,
+    PreparationStatus, VisionObservation, VlaRequest,
+};
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    if !(2..=3).contains(&args.len()) {
+        return Err("usage: pi05_fp4_graph_smoke <checkpoint-directory> [token-count=10]".into());
+    }
+    let root = PathBuf::from(&args[1]);
+    let tokens: usize = args.get(2).map(|v| v.parse()).transpose()?.unwrap_or(10);
+    let config = Pi05Config::from_json_file(&root.join("config.json"))?;
+    let options = LoadOptions {
+        model_name: Some("pi05".into()),
+        model_variant: Some("nvfp4_static".into()),
+        ..LoadOptions::default()
+    };
+    let model = AutoModel::load_model(Device::Cuda(0), &root, &options)?;
+    let observation = Observation {
+        vision: VisionObservation::Patches(Tensor::zeros(
+            vec![config.num_views * config.patches_per_view(),
+                 3 * config.patch_size * config.patch_size], DType::F32)),
+        token_ids: vec![0; tokens], state: None, action_mask: None,
+    };
+    let shape = vec![config.action_horizon, config.action_dim];
+    let elements = shape.iter().product::<usize>();
+    let noise: Vec<Tensor> = [0.0f32, 0.125].into_iter()
+        .map(|v| Tensor::from_f32(shape.clone(), &vec![v; elements]))
+        .collect::<apxinf_core::Result<_>>()?;
+    let spec = observation.inference_spec();
+    let mut reference = Vec::new();
+    {
+        let eager = model.prepare_with_policy(&spec, ExecutionPolicy::Eager)?;
+        for value in &noise {
+            let output = eager.run(&VlaRequest::provided(&observation, value))?;
+            reference.push(apxinf_cuda::transfers::to_cpu(output.tensor())?.to_f32_vec()?);
+        }
+    } // Drop the eager plan before creating the sole captured graph.
+    let graph = model.prepare_for(
+        &VlaRequest::provided(&observation, &noise[0]), ExecutionPolicy::RequireGraph)?;
+    assert_eq!(graph.status(), PreparationStatus::Ready {
+        mode: ExecutionMode::Graph, fallback_reason: None,
+    });
+    for index in [0usize, 1, 0] {
+        let output = graph.run(&VlaRequest::provided(&observation, &noise[index]))?;
+        let values = apxinf_cuda::transfers::to_cpu(output.tensor())?.to_f32_vec()?;
+        let expected = &reference[index];
+        if values.len() != expected.len() || values.len() != elements ||
+            values.iter().chain(expected).any(|x| !x.is_finite()) {
+            return Err("nonfinite output or invalid action shape".into());
+        }
+        let max_abs = values.iter().zip(expected)
+            .map(|(a,b)| (a-b).abs()).fold(0.0f32, f32::max);
+        if max_abs > 0.01 {
+            return Err(format!("NVFP4 eager/graph mismatch: {max_abs}").into());
+        }
+        println!("noise_index={index} elements={} max_abs={max_abs}", values.len());
+    }
+    println!("NVFP4 full-model RequireGraph PASS: 2 eager references, 3 changed-input replays; no implicit-plan allocation");
+    Ok(())
+}
