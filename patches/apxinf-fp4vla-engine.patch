diff --git a/crates/apxinf-cuda/adapters/fp4_plan_cache.cuh b/crates/apxinf-cuda/adapters/fp4_plan_cache.cuh
new file mode 100644
index 0000000..abc0cd3
--- /dev/null
+++ b/crates/apxinf-cuda/adapters/fp4_plan_cache.cuh
@@ -0,0 +1,114 @@
+// Host-only execution-resource cache for the fixed NVFP4/F16 adapter contract.
+// Every plan is prepared outside capture. Shape, device, stream and scratch
+// capacity constrain reuse; dtype/layout/VEC16 scale mode are fixed below.
+#pragma once
+#include <cuda_runtime.h>
+#include <cublasLt.h>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <tuple>
+
+namespace fp4_resources {
+struct Plan {
+    cublasLtHandle_t handle = nullptr;
+    cublasLtMatmulDesc_t op = nullptr;
+    cublasLtMatrixLayout_t a = nullptr, b = nullptr, c = nullptr;
+    cublasLtMatmulHeuristicResult_t heuristic{};
+    ~Plan() {
+        if (c) cublasLtMatrixLayoutDestroy(c);
+        if (b) cublasLtMatrixLayoutDestroy(b);
+        if (a) cublasLtMatrixLayoutDestroy(a);
+        if (op) cublasLtMatmulDescDestroy(op);
+        if (handle) cublasLtDestroy(handle);
+    }
+    cublasStatus_t scales(const void* as, const void* bs) {
+        auto st = cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_A_SCALE_POINTER,
+                                                &as, sizeof(as));
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        return cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_B_SCALE_POINTER,
+                                              &bs, sizeof(bs));
+    }
+    cublasStatus_t prepare(int m, int n, int k, size_t bytes,
+                           const void* as, const void* bs) {
+        auto st = cublasLtCreate(&handle);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatmulDescCreate(&op, CUBLAS_COMPUTE_32F, CUDA_R_32F);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        cublasOperation_t trans = CUBLAS_OP_T, normal = CUBLAS_OP_N;
+        st = cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSA, &trans, sizeof(trans));
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSB, &normal, sizeof(normal));
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        cublasLtMatmulMatrixScale_t mode = CUBLASLT_MATMUL_MATRIX_SCALE_VEC16_UE4M3;
+        st = cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_A_SCALE_MODE, &mode, sizeof(mode));
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_B_SCALE_MODE, &mode, sizeof(mode));
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = scales(as, bs);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatrixLayoutCreate(&a, CUDA_R_4F_E2M1, k, m, k);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatrixLayoutCreate(&b, CUDA_R_4F_E2M1, k, n, k);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatrixLayoutCreate(&c, CUDA_R_16F, m, n, m);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        cublasLtMatmulPreference_t pref = nullptr;
+        st = cublasLtMatmulPreferenceCreate(&pref);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        st = cublasLtMatmulPreferenceSetAttribute(pref, CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES,
+                                                 &bytes, sizeof(bytes));
+        int count = 0;
+        if (st == CUBLAS_STATUS_SUCCESS)
+            st = cublasLtMatmulAlgoGetHeuristic(handle, op, a, b, c, c, pref, 1, &heuristic, &count);
+        cublasLtMatmulPreferenceDestroy(pref);
+        if (st != CUBLAS_STATUS_SUCCESS) return st;
+        return count ? CUBLAS_STATUS_SUCCESS : CUBLAS_STATUS_NOT_SUPPORTED;
+    }
+};
+
+using Key = std::tuple<int, std::uintptr_t, int, int, int, size_t>;
+// Match the existing static BF16 adapter's per-host-thread resource ownership.
+// No graph execution invokes this map; replay contains already captured work.
+static thread_local std::map<Key, std::unique_ptr<Plan>> plans;
+
+static cublasStatus_t get(int m, int n, int k, size_t bytes, cudaStream_t stream,
+                          const void* as, const void* bs, bool may_prepare, Plan** output) {
+    if (m <= 0 || n <= 0 || k <= 0 || k % 16 || !as || !bs)
+        return CUBLAS_STATUS_INVALID_VALUE;
+    int device = 0;
+    if (cudaGetDevice(&device) != cudaSuccess) return CUBLAS_STATUS_INTERNAL_ERROR;
+    Key key(device, reinterpret_cast<std::uintptr_t>(stream), m, n, k, bytes);
+    auto found = plans.find(key);
+    if (found != plans.end()) {
+        *output = found->second.get();
+        return CUBLAS_STATUS_SUCCESS;
+    }
+    if (!may_prepare) return CUBLAS_STATUS_NOT_INITIALIZED;
+    // Legacy standalone callers can prepare lazily, but never while recording.
+    cudaStreamCaptureStatus capturing;
+    if (cudaStreamIsCapturing(stream, &capturing) != cudaSuccess)
+        return CUBLAS_STATUS_INTERNAL_ERROR;
+    if (capturing != cudaStreamCaptureStatusNone) return CUBLAS_STATUS_NOT_INITIALIZED;
+    auto plan = std::make_unique<Plan>();
+    auto status = plan->prepare(m, n, k, bytes, as, bs);
+    if (status != CUBLAS_STATUS_SUCCESS) return status;
+    *output = plan.get();
+    plans.emplace(key, std::move(plan));
+    return CUBLAS_STATUS_SUCCESS;
+}
+
+static cublasStatus_t execute(int m, int n, int k, const void* a, const void* b,
+    const void* as, const void* bs, float alpha, __half* output,
+    void* workspace, size_t bytes, cudaStream_t stream, bool may_prepare) {
+    Plan* plan = nullptr;
+    auto status = get(m, n, k, bytes, stream, as, bs, may_prepare, &plan);
+    if (status != CUBLAS_STATUS_SUCCESS) return status;
+    status = plan->scales(as, bs);
+    if (status != CUBLAS_STATUS_SUCCESS) return status;
+    const float zero = 0.f;
+    // alpha and scale pointers belong to this call, never to the cached shape.
+    return cublasLtMatmul(plan->handle, plan->op, &alpha, a, plan->a, b, plan->b,
+        &zero, output, plan->c, output, plan->c, &plan->heuristic.algo, workspace, bytes, stream);
+}
+} // namespace fp4_resources
diff --git a/crates/apxinf-cuda/src/kernels/fp4_contract_tests.rs b/crates/apxinf-cuda/src/kernels/fp4_contract_tests.rs
new file mode 100644
index 0000000..c90ff86
--- /dev/null
+++ b/crates/apxinf-cuda/src/kernels/fp4_contract_tests.rs
@@ -0,0 +1,190 @@
+// Self-contained composition regression: non-square row-major output and a
+// non-unit secondary weight scale. No external checkpoint or /tmp gold files.
+use super::*;
+
+fn e4m3_value(code: u8) -> f32 {
+    let e = (code >> 3) & 15;
+    let mantissa = (code & 7) as f32;
+    if e == 0 { mantissa * 2f32.powi(-9) }
+    else { (1.0 + mantissa / 8.0) * 2f32.powi(e as i32 - 7) }
+}
+
+fn e2m1_value(code: u8) -> f32 {
+    let magnitude = [0., 0.5, 1., 1.5, 2., 3., 4., 6.][(code & 7) as usize];
+    if code & 8 != 0 { -magnitude } else { magnitude }
+}
+
+fn upload(ctx: &CudaContext, bytes: &[u8]) -> CudaBuffer {
+    let buffer = CudaBuffer::alloc_on(ctx, bytes.len()).unwrap();
+    buffer.copy_from_host(bytes).unwrap();
+    buffer
+}
+
+#[test]
+#[ignore = "requires a CUDA device supporting NVFP4 cuBLASLt (e.g. sm_120)"]
+fn fp4_contract_rowmajor_and_tensor_scale() {
+    let ctx = CudaContext::new(0).expect("CUDA context");
+    // M != N exposes a column-major buffer mislabeled as a row-major Tensor.
+    for (m, n, k) in [(16usize, 64usize, 64usize), (64, 128, 128)] {
+        let kb = k / 16;
+        let mut x_values = vec![0f32; m * k];
+        for row in 0..m {
+            for block in 0..kb {
+                let scale = if row == 0 { 0.0 } else { e4m3_value(32 + ((row + block) % 8) as u8) };
+                for offset in 0..16 {
+                    // Every nonzero block contains +6, so its scale is exact
+                    // and the online quantizer preserves these activations.
+                    let code = if offset == 15 { 7 } else { ((row * 3 + block + offset) % 16) as u8 };
+                    x_values[row * k + block * 16 + offset] = e2m1_value(code) * scale;
+                }
+            }
+        }
+        let x_bytes: Vec<u8> = x_values.iter().flat_map(|v| half::f16::from_f32(*v).to_le_bytes()).collect();
+        let x = upload(&ctx, &x_bytes).into_tensor(Shape::new(vec![m, k]), DType::F16);
+        let mut packed = vec![0u8; n * k / 2];
+        let panel_stride = 512 * ((kb + 3) / 4);
+        let mut swizzled = vec![0u8; panel_stride * ((n + 127) / 128)];
+        let mut w_values = vec![0f32; n * k];
+        for row in 0..n {
+            for block in 0..kb {
+                let code = if row == 0 { 0 } else { 40 + ((row + 3 * block) % 8) as u8 };
+                let scale = e4m3_value(code);
+                let address = panel_stride * (row / 128) + 512 * (block / 4)
+                    + 16 * (row % 32) + 4 * ((row / 32) % 4) + block % 4;
+                swizzled[address] = code;
+                for offset in (0..16).step_by(2) {
+                    let low = ((row * 7 + block * 3 + offset) % 16) as u8;
+                    let high = ((row + block * 5 + offset + 1) % 16) as u8;
+                    let position = row * k + block * 16 + offset;
+                    packed[position / 2] = low | (high << 4);
+                    w_values[position] = e2m1_value(low) * scale;
+                    w_values[position + 1] = e2m1_value(high) * scale;
+                }
+            }
+        }
+        let packed_device = upload(&ctx, &packed);
+        let scale_device = upload(&ctx, &swizzled);
+        for tensor_scale in [0.03125f32, 2.5] {
+            let weight = Fp4WeightView {
+                packed: &packed_device, scale: &scale_device,
+                tscale: tensor_scale, rows: n, k,
+            };
+            let output = fp4_linear(&ctx, &x, &weight).expect("NVFP4 composition");
+            assert_eq!(output.shape().dims(), &[m, n]);
+            ctx.synchronize().unwrap();
+            let mut bytes = vec![0u8; m * n * 2];
+            CudaBuffer::from_tensor(&output).unwrap().copy_to_host(&mut bytes).unwrap();
+            let mut max_abs = 0f32;
+            for row in 0..m {
+                for col in 0..n {
+                    let reference: f32 = (0..k).map(|i| x_values[row*k+i] * w_values[col*k+i]).sum();
+                    let expected = half::f16::from_f32(reference * tensor_scale).to_f32();
+                    let address = 2 * (row * n + col);
+                    let actual = half::f16::from_le_bytes([bytes[address], bytes[address+1]]).to_f32();
+                    let error = (actual - expected).abs();
+                    max_abs = max_abs.max(error);
+                    assert!(actual.is_finite() && error <= 0.001 + 0.002 * expected.abs(),
+                        "M={m} N={n} K={k} scale={tensor_scale} [{row},{col}]: {actual} vs {expected}");
+                }
+            }
+            eprintln!("fp4_contract M={m} N={n} K={k} tensor_scale={tensor_scale} max_abs={max_abs}");
+        }
+    }
+}
+
+#[test]
+#[ignore = "requires exclusive NVFP4-capable GPU; validates captured addresses and replay"]
+fn fp4_graph_replay_bf16_and_distinct_scales() {
+    let ctx = CudaContext::new(0).expect("CUDA context");
+    let (m, n, k) = (16usize, 64usize, 64usize);
+    let input_bytes = |value: f32| -> Vec<u8> {
+        (0..m*k).flat_map(|_| half::bf16::from_f32(value).to_le_bytes()).collect()
+    };
+    let x = upload(&ctx, &input_bytes(0.75))
+        .into_tensor(Shape::new(vec![m, k]), DType::BF16);
+    let packed = upload(&ctx, &vec![0x77; n*k/2]); // E2M1 +6 in both nibbles.
+    let kb = k/16;
+    let mut scale = vec![0; 512*((kb+3)/4)*((n+127)/128)];
+    for row in 0..n {
+        for block in 0..kb {
+            let offset = 512*((kb+3)/4)*(row/128) + 512*(block/4)
+                + 16*(row%32) + 4*((row/32)%4) + block%4;
+            scale[offset] = 0x20; // E4M3 0.125 => decoded weight 0.75.
+        }
+    }
+    let scale_two_bytes: Vec<u8> = scale.iter().map(|v| if *v == 0x20 { 0x28 } else { *v }).collect();
+    let scale = upload(&ctx, &scale);
+    let scale_two = upload(&ctx, &scale_two_bytes); // E4M3 0.25 => weight 1.5.
+    let w1 = Fp4WeightView {packed:&packed, scale:&scale, tscale:0.5, rows:n, k};
+    let w2 = Fp4WeightView {scale:&scale_two, tscale:2.0, ..w1};
+    let workspace = crate::workspace::GraphWorkspace::new(
+        2 * fp4_graph_buffer_bytes(m,n,k).unwrap(), ctx.device_id()).unwrap();
+    let dirty_arena = crate::workspace::with_workspace(&workspace,
+        || crate::workspace::output_buffer(&ctx, workspace.capacity())).unwrap();
+    dirty_arena.memset_async(0x7f, dirty_arena.len(), ctx.stream()).unwrap();
+    ctx.synchronize().unwrap();
+    drop(dirty_arena);
+    let invoke = || -> Result<(Tensor, Tensor)> {
+        Ok((fp4_linear_bf16(&ctx,&x,&w1)?, fp4_linear_bf16(&ctx,&x,&w2)?))
+    };
+    let prepared = crate::workspace::prepare_with_workspace(&workspace, invoke).unwrap();
+    ctx.synchronize().unwrap();
+    drop(prepared);
+    crate::graph::begin(&ctx, crate::graph::CaptureMode::ThreadLocal).unwrap();
+    let captured = crate::workspace::with_workspace(&workspace, invoke);
+    if let Err(error) = &captured {
+        crate::graph::abort(&ctx);
+        panic!("FP4 capture failed: {error}");
+    }
+    let outputs = captured.unwrap();
+    let graph = crate::graph::end(&ctx).expect("FP4 graph instantiate");
+    // Repeatedly change the same input allocation, including zero blocks.
+    // Both same-shape calls must keep their own alpha and arena scale address.
+    for input in [0.75f32, 1.5, 0.0, 0.75] {
+        CudaBuffer::from_tensor(&x).unwrap().copy_from_host(&input_bytes(input)).unwrap();
+        graph.replay().unwrap();
+        ctx.synchronize().unwrap();
+        for (output, weight, tensor_scale) in [(&outputs.0,0.75f32,0.5f32),(&outputs.1,1.5,2.0)] {
+            let expected = input * weight * k as f32 * tensor_scale;
+            let mut bytes = vec![0; m*n*2];
+            CudaBuffer::from_tensor(output).unwrap().copy_to_host(&mut bytes).unwrap();
+            for pair in bytes.chunks_exact(2) {
+                let got = half::bf16::from_le_bytes([pair[0],pair[1]]).to_f32();
+                assert_eq!(got, expected, "input={input}, tensor_scale={tensor_scale}");
+            }
+        }
+    }
+    eprintln!("FP4 graph capture/replay PASS: 4 changed-input replays, 2 scales, every output checked");
+}
+
+#[test]
+#[ignore = "requires exclusive CUDA GPU; checks every padded activation-scale byte"]
+fn fp4_activation_padding_zero_after_capture() {
+    let ctx = CudaContext::new(0).unwrap();
+    let (rows,k) = (3usize,48usize); // Both row and K-scale dimensions have padding.
+    let input: Vec<u8> = (0..rows*k)
+        .flat_map(|_| half::f16::from_f32(0.75).to_le_bytes()).collect();
+    let x = upload(&ctx,&input);
+    let packed = upload(&ctx,&vec![0xff;rows*k/2]);
+    let scales = upload(&ctx,&vec![0x7f;512]);
+    crate::graph::begin(&ctx,crate::graph::CaptureMode::ThreadLocal).unwrap();
+    let status = unsafe { ffi::apxinf_nvfp4_quantize_activation(
+        x.ptr(),packed.ptr(),scales.ptr(),rows as i32,k as i32,ctx.stream().handle()) };
+    if status != 0 { crate::graph::abort(&ctx); panic!("capture quantizer status={status}"); }
+    let graph = crate::graph::end(&ctx).unwrap();
+    let mut expected = vec![0u8;512];
+    for row in 0..rows {
+        for block in 0..k/16 {
+            expected[16*(row%32)+4*((row/32)%4)+block%4] = 0x20;
+        }
+    }
+    for poison in [0x7f,0xff] {
+        scales.memset_async(poison,scales.len(),ctx.stream()).unwrap();
+        graph.replay().unwrap();
+        ctx.synchronize().unwrap();
+        let mut got=vec![0u8;512];
+        scales.copy_to_host(&mut got).unwrap();
+        assert_eq!(got,expected,"padding changed after poison={poison}");
+    }
+    eprintln!("FP4 activation scale padding PASS: all 512 bytes, row/K padding, 2 poisoned replays");
+}
