+++ b/crates/apxinf-model/src/pi05/fp4_weights.rs
@@ -0,0 +1,141 @@
+//! NVFP4 device weights loaded from fp4vla offline artifacts (step 2 of the
+//! fp4 engine path; see fp4vla docs/fp4-engine-design.md).
+//!
+//! Artifact contract (produced by fp4vla quant/nvfp4_convert.py):
+//!   <dir>/<stem>.packed.u8   rows x K/2 bytes, E2M1 pairs (low nibble = even k)
+//!   <dir>/<stem>.scale.u8    cuBLASLt VEC16_UE4M3 physical swizzle layout
+//!   <dir>/manifest.json      summary + per-tensor {shape, block=16, tscale}
+//!
+//! The artifacts are immutable by construction (QAD freezes scales), so this
+//! loader only uploads bytes; it never re-quantizes.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use apxinf_cuda::CudaBuffer;
+use apxinf_core::{Error, Result};
+
+#[derive(Debug, Clone, serde::Deserialize)]
+pub struct Fp4TensorMeta {
+    pub name: String,
+    pub shape: Vec<usize>,
+    pub block: usize,
+    pub tscale: f32,
+    #[serde(default)]
+    pub rel_frob: Option<f64>,
+}
+
+#[derive(Debug, Clone, serde::Deserialize)]
+pub struct Fp4Manifest {
+    #[serde(default)]
+    pub summary: Option<serde_json::Value>,
+    pub tensors: Vec<Fp4TensorMeta>,
+}
+
+/// One quantized weight matrix resident on the device.
+pub struct Fp4DeviceWeight {
+    pub packed: CudaBuffer,   // E2M1 pairs, rows x K/2 bytes
+    pub scale: CudaBuffer,    // physical swizzle bytes
+    pub tscale: f32,          // per-tensor FP32 secondary scale
+    pub rows: usize,
+    pub k: usize,
+}
+
+impl Fp4DeviceWeight {
+    pub fn m(&self) -> usize { self.rows }
+    pub fn n_from(&self, other_rows: usize) -> usize { other_rows }
+    pub fn k(&self) -> usize { self.k }
+}
+
+/// The full set of NVFP4 tensors for a model shard, keyed by checkpoint name
+/// (dots replace path separators, matching fp4vla's stem convention).
+pub struct Fp4DeviceWeights {
+    pub tensors: HashMap<String, Fp4DeviceWeight>,
+}
+
+fn read_exact(path: &Path) -> Result<Vec<u8>> {
+    std::fs::read(path).map_err(|e| {
+        Error::Other(format!("fp4 artifact read {}: {e}", path.display()))
+    })
+}
+
+impl Fp4DeviceWeights {
+    /// Load every artifact tensor in `dir` onto `device`.
+    pub fn from_artifact_dir(dir: &Path, device: usize) -> Result<Self> {
+        let manifest_path = dir.join("manifest.json");
+        let manifest: Fp4Manifest = serde_json::from_slice(&read_exact(&manifest_path)?)
+            .map_err(|e| Error::Other(format!("fp4 manifest parse: {e}")))?;
+        let mut tensors = HashMap::with_capacity(manifest.tensors.len());
+        for meta in &manifest.tensors {
+            let stem = meta.name.replace('/', ".");
+            let packed_path = dir.join(format!("{stem}.packed.u8"));
+            let scale_path = dir.join(format!("{stem}.scale.u8"));
+            if !packed_path.is_file() || !scale_path.is_file() {
+                // Partial artifacts are legal: the exemption table decides
+                // which tensors a model keeps in BF16; missing files here
+                // simply mean "not quantized in this artifact".
+                continue;
+            }
+            let rows = meta.shape.first().copied().unwrap_or(0);
+            let k = meta.shape.get(1).copied().unwrap_or(0);
+            if rows == 0 || k == 0 || k % 16 != 0 {
+                return Err(Error::Other(format!(
+                    "fp4 artifact bad shape for {}: {rows}x{k}",
+                    meta.name
+                )));
+            }
+            let packed_bytes = read_exact(&packed_path)?;
+            if packed_bytes.len() != rows * k / 2 {
+                return Err(Error::Other(format!(
+                    "fp4 packed size mismatch {}: file {} expected {}",
+                    meta.name,
+                    packed_bytes.len(),
+                    rows * k / 2
+                )));
+            }
+            let scale_bytes = read_exact(&scale_path)?;
+            // swizzle buffer size (mirrors adapters/cublaslt_fp4_adapter.cu
+            // apxinf_fp4_scale_buffer_bytes; kept inline because apxinf-cuda
+            // keeps its ffi module private)
+            let kb = (k + 15) / 16;
+            let expected_scale = 512 * ((kb + 3) / 4) * ((rows + 127) / 128);
+            if scale_bytes.len() != expected_scale {
+                return Err(Error::Other(format!(
+                    "fp4 scale size mismatch {}: file {} expected {expected_scale}",
+                    meta.name,
+                    scale_bytes.len()
+                )));
+            }
+            let mut packed = CudaBuffer::alloc(packed_bytes.len(), device)
+                .map_err(Error::Cuda)?;
+            packed.copy_from_host(&packed_bytes).map_err(Error::Cuda)?;
+            let mut scale = CudaBuffer::alloc(scale_bytes.len(), device)
+                .map_err(Error::Cuda)?;
+            scale.copy_from_host(&scale_bytes).map_err(Error::Cuda)?;
+            tensors.insert(
+                meta.name.clone(),
+                Fp4DeviceWeight { packed, scale, tscale: meta.tscale, rows, k },
+            );
+        }
+        if tensors.is_empty() {
+            return Err(Error::Other(format!(
+                "fp4 artifact dir {} loaded zero tensors",
+                dir.display()
+            )));
+        }
+        Ok(Self { tensors })
+    }
+
+    pub fn get(&self, name: &str) -> Option<&Fp4DeviceWeight> {
+        self.tensors.get(name)
+    }
+
+    pub fn len(&self) -> usize { self.tensors.len() }
+    pub fn is_empty(&self) -> bool { self.tensors.is_empty() }
+}
+
+#[cfg(all(test, feature = "cuda"))]
+mod fp4_tests {
+    use super::*;
+    include!("fp4_weights_tests.rs");
+}
