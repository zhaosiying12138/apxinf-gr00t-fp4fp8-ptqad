diff --git a/crates/apxinf-cuda/adapters/cublaslt_fp4_adapter.cu b/crates/apxinf-cuda/adapters/cublaslt_fp4_adapter.cu
new file mode 100644
index 0000000..729ffd8
--- /dev/null
+++ b/crates/apxinf-cuda/adapters/cublaslt_fp4_adapter.cu
@@ -0,0 +1,207 @@
+// cublaslt_fp4_adapter.cu — NVFP4 block-scaled GEMM adapter (FP4-VLA).
+//
+// Layout/semantics verified bit-exact against CPU reference on sm_120
+// (RTX 5090 Laptop) by fp4vla spike/fp4_gemm_bench.cu:
+//   A stored MxK K-major (col-major KxM, opA=T), B stored NxK K-major
+//   (col-major KxN, opB=N), C F16 col-major MxN.
+//   Scales: E4M3 per-16 along K, physical swizzle
+//     PS = 512*ceil(KB/4);  off(r,b) = PS*(r/128) + 512*(b/4) + 16*(r%32)
+//                              + 4*((r/32)%4) + (b%4)
+//   Scale mode: CUBLASLT_MATMUL_MATRIX_SCALE_VEC16_UE4M3.
+// E2M1 data packing: 2 values/byte, even k in low nibble.
+// CUDA 13: layouts are column-major only; matmul takes handle+algo ptr.
+
+#include <cstdint>
+#include <cuda_fp16.h>
+#include <cuda_fp8.h>
+#include <cuda_fp4.h>
+#include <cublasLt.h>
+#include "fp4_plan_cache.cuh"
+
+static cublasStatus_t fp4_gemm_colmajor_f16(
+    int m, int n, int k, const void* a, const void* b,
+    const void* as, const void* bs, __half* c, float alpha,
+    void* workspace, size_t bytes, cudaStream_t stream) {
+    return fp4_resources::execute(m, n, k, a, b, as, bs, alpha, c,
+                                  workspace, bytes, stream, true);
+}
+
+// Legacy raw adapter ABI: callers explicitly consume column-major output and
+// supply tensors with unit secondary scales. Retained for standalone probes.
+extern "C" cublasStatus_t apxinf_fp4_gemm_f16(
+    int m, int n, int k, const void* a, const void* b,
+    const void* as, const void* bs, __half* c,
+    void* workspace, size_t workspace_bytes, cudaStream_t stream)
+{
+    return fp4_gemm_colmajor_f16(m, n, k, a, b, as, bs, c, 1.0f,
+                                  workspace, workspace_bytes, stream);
+}
+
+// Tensor API: row-major C[m,n] = alpha * A[m,k] * B[n,k]^T.
+// Compute C^T = B * A^T as column-major [n,m]. Its contiguous bytes are
+// exactly row-major [m,n], avoiding a separate transpose or a stride relabel.
+extern "C" cublasStatus_t apxinf_fp4_gemm_rowmajor_scaled_f16(
+    int m, int n, int k, const void* a, const void* b,
+    const void* as, const void* bs, float tensor_scale_product, __half* c,
+    void* workspace, size_t workspace_bytes, cudaStream_t stream)
+{
+    if (m <= 0 || n <= 0 || k <= 0 || k % 16 != 0 ||
+        !isfinite(tensor_scale_product) || tensor_scale_product <= 0.0f)
+        return CUBLAS_STATUS_INVALID_VALUE;
+    return fp4_gemm_colmajor_f16(n, m, k, b, a, bs, as, c, tensor_scale_product,
+                                  workspace, workspace_bytes, stream);
+}
+
+// Explicit prepare/execute split for the native GraphWorkspace path.
+extern "C" cublasStatus_t apxinf_fp4_prepare_rowmajor_f16(
+    int m, int n, int k, const void* as, const void* bs,
+    size_t workspace_bytes, cudaStream_t stream) {
+    fp4_resources::Plan* plan = nullptr;
+    return fp4_resources::get(n, m, k, workspace_bytes, stream, bs, as, true, &plan);
+}
+
+extern "C" cublasStatus_t apxinf_fp4_gemm_rowmajor_prepared_f16(
+    int m, int n, int k, const void* a, const void* b,
+    const void* as, const void* bs, float alpha, __half* c,
+    void* workspace, size_t workspace_bytes, cudaStream_t stream) {
+    if (!isfinite(alpha) || alpha <= 0.f) return CUBLAS_STATUS_INVALID_VALUE;
+    return fp4_resources::execute(n, m, k, b, a, bs, as, alpha, c,
+                                  workspace, workspace_bytes, stream, false);
+}
+
+// Swizzled-scale buffer size helper (matches fp4vla fp4_quant.swizzle_scales).
+extern "C" size_t apxinf_fp4_scale_buffer_bytes(int rows, int k) {
+    int kb = (k + 15) / 16;
+    size_t ps = 512u * ((kb + 3) / 4);
+    return ps * ((rows + 127) / 128);
+}
+
+// ---- online activation quantizer: f16 -> NVFP4 (packed + swizzled scales) ----
+// One thread per 16-element block. E4M3 scale via bit-exact round (RNE on the
+// fp8 log-lattice), E2M1 via midpoint ladder — mirrors fp4vla fp4_quant.py.
+
+__device__ __forceinline__ uint8_t fp4_enc_e4m3(float v) {
+    if (v >= 448.0f) return 0x7E;
+    if (v <= 0.0f)   return 0;
+    float m = v, e = 0;
+    while (m >= 2.0f) { m *= 0.5f; e += 1.0f; }
+    while (m <  1.0f) { m *= 2.0f; e -= 1.0f; }
+    int exp = (int)e + 7;
+    if (exp <= 0) {
+        // RNE ties-to-even on the subnormal integer grid
+        float g = v * 512.0f; int fl = (int)g; float frac = g - fl;
+        int s = frac > 0.5f ? fl + 1 : frac < 0.5f ? fl : (fl % 2 == 0 ? fl : fl + 1);
+        return (uint8_t)min(max(s, 0), 8);
+    }
+    float gm = (m - 1.0f) * 8.0f; int fl = (int)gm; float frac = gm - fl;
+    int man = frac > 0.5f ? fl + 1 : frac < 0.5f ? fl : (fl % 2 == 0 ? fl : fl + 1);
+    if (man > 7) { man = 0; exp += 1; }
+    if (exp > 15) return 0x7E;
+    return (uint8_t)((exp << 3) | man);
+}
+__device__ __forceinline__ float fp4_dec_e4m3(uint8_t b) {
+    int e = (b >> 3) & 0xF, m = b & 0x7;
+    if (e == 0) return m * 0.001953125f;
+    return (1.0f + m * 0.125f) * exp2f((float)(e - 7));
+}
+__device__ __forceinline__ float fp4_e2m1_mag(float a) {
+    // nearest with ties-to-EVEN-code (code order: 0,.5,1,1.5,2,3,4,6);
+    // exact midpoints map to the even code of the bracketing pair.
+    if (a < 0.25f) return 0.0f;
+    if (a == 0.25f) return 0.0f;   // even code 0
+    if (a < 0.75f) return 0.5f;
+    if (a == 0.75f) return 1.0f;   // even code 2 (value 1.0)
+    if (a < 1.25f) return 1.0f;
+    if (a == 1.25f) return 1.0f;   // even code 2
+    if (a < 1.75f) return 1.5f;
+    if (a == 1.75f) return 2.0f;   // even code 4 (value 2.0)
+    if (a < 2.5f)  return 2.0f;
+    if (a == 2.5f)  return 2.0f;   // even code 4
+    if (a < 3.5f)  return 3.0f;
+    if (a == 3.5f)  return 4.0f;   // even code 6 (value 4.0)
+    if (a < 5.0f)  return 4.0f;
+    if (a == 5.0f)  return 4.0f;   // even code 6
+    return 6.0f;
+}
+
+__global__ void nvfp4_quantize_activation_kernel(
+    const __half* __restrict__ x, uint8_t* __restrict__ packed,
+    uint8_t* __restrict__ scale_swz, int rows, int kb)
+{
+    int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    int total = rows * kb;
+    if (tid >= total) return;
+    int r = tid / kb, b = tid - r * kb;
+    int k = kb * 16;
+    const __half* blk = x + (size_t)r * k + b * 16;
+    float vals[16]; float amax = 0.0f;
+    #pragma unroll
+    for (int j = 0; j < 16; ++j) {
+        vals[j] = __half2float(blk[j]);
+        amax = fmaxf(amax, fabsf(vals[j]));
+    }
+    uint8_t sb = fp4_enc_e4m3(amax * (1.0f / 6.0f));
+    float sd = fp4_dec_e4m3(sb);
+    if (sd <= 0.0f) sd = 1.0f;
+    // division (not reciprocal-multiply) to match the CPU fp32 rounding path
+    #pragma unroll
+    for (int j = 0; j < 16; j += 2) {
+        float q0 = min(fp4_e2m1_mag(fabsf(vals[j]) / sd), 6.0f);
+        float q1 = min(fp4_e2m1_mag(fabsf(vals[j+1]) / sd), 6.0f);
+        uint8_t lo = q0 == 0 ? 0 : q0 == 0.5f ? 1 : q0 == 1 ? 2 : q0 == 1.5f ? 3
+                   : q0 == 2 ? 4 : q0 == 3 ? 5 : q0 == 4 ? 6 : 7;
+        uint8_t hi = q1 == 0 ? 0 : q1 == 0.5f ? 1 : q1 == 1 ? 2 : q1 == 1.5f ? 3
+                   : q1 == 2 ? 4 : q1 == 3 ? 5 : q1 == 4 ? 6 : 7;
+        if (vals[j]     < 0.0f) lo |= 0x8;
+        if (vals[j + 1] < 0.0f) hi |= 0x8;
+        packed[(size_t)(r * k + b * 16 + j) / 2] = (uint8_t)(lo | (hi << 4));
+    }
+    size_t ps = 512ull * ((kb + 3) / 4);
+    size_t off = ps * (r / 128) + 512ull * (b / 4) + 16ull * (r % 32)
+               + 4ull * ((r / 32) % 4) + (b % 4);
+    scale_swz[off] = sb;
+}
+
+extern "C" cudaError_t apxinf_nvfp4_quantize_activation(
+    const void* x, void* packed, void* scale_swz,
+    int rows, int k, cudaStream_t stream)
+{
+    if (rows <= 0 || k <= 0 || k % 16 != 0) return cudaErrorInvalidValue;
+    int kb = k / 16;
+    int total = rows * kb;
+    // The physical scale tile contains padded rows/K blocks. A graph arena is
+    // reused storage, so every invocation must define those bytes as zero.
+    // This stream-ordered clear is captured/replayed with the quantizer.
+    size_t scale_bytes = 512ull * ((kb + 3ull) / 4) * ((rows + 127ull) / 128);
+    cudaError_t cleared = cudaMemsetAsync(scale_swz, 0, scale_bytes, stream);
+    if (cleared != cudaSuccess) return cleared;
+    nvfp4_quantize_activation_kernel<<<(total + 255) / 256, 256, 0, stream>>>(
+        (const __half*)x, (uint8_t*)packed, (uint8_t*)scale_swz, rows, kb);
+    return cudaGetLastError();
+}
+
+__global__ void bf16_to_f16_kernel(const __nv_bfloat16* __restrict__ x,
+                                   __half* __restrict__ y, size_t n) {
+    size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) y[i] = __float2half(__bfloat162float(x[i]));
+}
+extern "C" cudaError_t apxinf_bf16_to_f16(const void* x, void* y, size_t n,
+                                          cudaStream_t stream) {
+    if (n == 0) return cudaSuccess;
+    bf16_to_f16_kernel<<<(unsigned)((n + 255) / 256), 256, 0, stream>>>(
+        (const __nv_bfloat16*)x, (__half*)y, n);
+    return cudaGetLastError();
+}
+
+__global__ void f16_to_bf16_kernel(const __half* __restrict__ x,
+                                   __nv_bfloat16* __restrict__ y, size_t n) {
+    size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) y[i] = __float2bfloat16(__half2float(x[i]));
+}
+extern "C" cudaError_t apxinf_f16_to_bf16(const void* x, void* y, size_t n,
+                                          cudaStream_t stream) {
+    if (n == 0) return cudaSuccess;
+    f16_to_bf16_kernel<<<(unsigned)((n + 255) / 256), 256, 0, stream>>>(
+        (const __half*)x, (__nv_bfloat16*)y, n);
+    return cudaGetLastError();
+}
